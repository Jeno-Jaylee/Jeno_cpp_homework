#include<iostream>
#include<string>
using namespace std;

//泛节点的定义
template<typename T>
class dnode{
    public:
    T data;
    dnode* prior;
    dnode* next;

    dnode(): prior(nullptr),next(nullptr),data(T()){};
    dnode(T a): prior(nullptr),next(nullptr),data(a){};   //节点的生成
};

//泛链表的定义
template<typename T>
class dlist{
    public:
    dnode<T>* head;     //头和尾为节点
    dnode<T>* end;
    int size;

    dlist(): head(nullptr),end(nullptr),size(0){};        //链表的生成
    ~dlist();                                            //链表的析构

    void insert_head(T a);           //头插入
    void insert_end(T a);            //尾插入
    void insert_before(string data,T a);      //前插入
    void insert_after(string data,T a);       //后插入

    void delete_head();      //头删除
    void delete_end();       //尾删除
    void delete_middle(string a);   //中删除
    
    void print_all();       //全查找
    void print_single(string a);    //单查找
};

//泛链表的实现（插入篇）
template<typename T>
dlist<T>::~dlist(){
    dnode<T>*p = head;
    while(p != nullptr){
        dnode<T>*q = p->next;
        delete p;
        p=q;
    }
    head=end=nullptr;
    size=0;
}
template<typename T>
void dlist<T>::insert_head(T a){
    dnode<T>* newnode=new dnode<T>(a);    //申请堆空间（如果是栈，函数使用后栈会被删除失效）
    
    if(end==nullptr){
        end=newnode;              //作用：添加链表的第一个元素时，end开始为nullptr，让其指向newnode；
        head=newnode;
        size++;
        return;
    }

    newnode->next=head;
    head->prior=newnode;             //涉及指针移动
    head=newnode;                    //豆子请画图仔细理解
    
    size++;
}
template<typename T>
void dlist<T>::insert_end(T a){
    dnode<T>* newnode=new dnode<T>(a);

    if(end==nullptr){
        end=newnode;              
        head=newnode;
        size++;
        return;
    }

    newnode->prior=end;
    end->next=newnode;
    end=newnode;

    size++;
}
template<typename T>
void dlist<T>::insert_before(string data,T a){
    dnode<T>* p=head;
    while(p!=nullptr){
        if(p->data.get_id()==data){
            cout<<"查找成功，前插完成"<<endl;
            dnode<T>* newnode=new dnode<T>(a);

            newnode->next=p;
            p->prior=newnode;
            newnode->prior=(p->prior);
            if(p->prior!=nullptr){p->prior->next=newnode;}      //if防止对第一位前插导致越界

            if(newnode->prior==nullptr){head=newnode;}        //if让第一位前插更新head
            size++;
            return;
        }
        p=p->next;
    }
    cout<<"对不起，查找失败，无法前插"<<endl;
}
template<typename T>
void dlist<T>::insert_after(string data,T a){
    dnode<T>* p=head;
    while(p!=nullptr){
        if(p->data.get_id()==data){
            cout<<"查找成功，后插完成"<<endl;
            dnode<T>* newnode=new dnode<T>(a);

            newnode->next=(p->next);
            if(p->next!=nullptr){(p->next)->prior=newnode;}     //if防止对最后一位尾插导致越界
            newnode->prior=p;
            p->next=newnode;

            if(newnode->next==nullptr){end=newnode;}       //if让第一位尾插更新end
            size++;
            return;
        }
        p=p->next;
    }
    cout<<"对不起，查找失败，无法后插"<<endl;
}

//泛链表的实现（删除篇）
template<typename T>
void dlist<T>::delete_head(){
    dnode<T>* p=head;
    if(head==nullptr){return;}   //防止空链表

    head=head->next;
    if(head!=nullptr){head->prior=nullptr;}    //如果新头不为空，则新头前指针置空
    delete p;
    size--;
    cout<<"删除成功"<<endl;
}
template<typename T>
void dlist<T>::delete_end(){
    dnode<T>*p=end;
    if(end==nullptr) return;   //防止空链表

    end=end->prior;
    if(end!=nullptr){end->next=nullptr;}     //如果新尾不为空，则新尾后指针置空
    delete p;
    size--;
    cout<<"删除成功"<<endl;
}
template<typename T>
void dlist<T>::delete_middle(string a){
    dnode<T>* p=head;
    while(p!=nullptr){
        if(p->data.get_id()==a){
            if(p->prior!=nullptr){p->prior->next=p->next;}    //前节点指向后节点
            if(p->next!=nullptr){p->next->prior=p->prior;}   //后节点指向前节点

            delete p;
            size--;
            cout<<"删除成功"<<endl;
            return;
        }
        p=p->next;
    }
    cout<<"对不起，查询失败，无法删除"<<endl;
}

//泛列表的实现（查找篇）
template<typename T>
void dlist<T>::print_all(){
    dnode<T>* p=head;
    while(p!=nullptr){
        cout<<p->data<<endl;
        p=p->next;
    }
    cout<<endl;
    cout<<"=====全查找完成====="<<endl;
}
template<typename T>
void dlist<T>::print_single(string a){
    dnode<T>* p=head;
    while(p!=nullptr){
        if(p->data.get_id()==a){
            cout<<"=====单查找成功====="<<endl;
            cout<<p->data<<endl;
            return;
        }
        p=p->next;
    }
    cout<<"=====单查找失败====="<<endl;
}

